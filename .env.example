# Copy this file to .env.local for local development.
# In production (Vercel), add the same keys under
# Project Settings -> Environment Variables.

# --- Contact form (Resend) ---
# Get a key at https://resend.com/api-keys (free tier is enough to start)
RESEND_API_KEY=
# Where contact form messages should be delivered
CONTACT_TO_EMAIL=meet.alshi@vit.edu.in

# --- Optional: dynamic file uploads (Vercel Blob) ---
# Only needed if you build the optional admin upload flow described in
# BACKEND.md. When you add a Blob store in the Vercel dashboard, this is
# injected automatically for deployed projects — you only need to set it
# by hand for local development (vercel env pull will do it for you).
BLOB_READ_WRITE_TOKEN=
